# Verisphere extension config for `--env production` (Vite mode "production").
# The extension talks only to the Verisphere app API; RPC/chain/LLM config lives
# there (server-side), not here.
VITE_APP_API_BASE=https://verisphere.co/api

# Data adapter: "mock" (self-contained) or "http" (live app API).
VITE_API_MODE=http

# Where "Buy VSP" links when a connected wallet has none.
VITE_BUY_VSP_URL=https://verisphere.co

# The app's portfolio page — user stakes and earnings (opens from the extension).
VITE_PORTFOLIO_URL=https://verisphere.co/portfolio
