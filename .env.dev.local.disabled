# Local-run override (git-ignored, loaded by Vite on top of .env.dev for
# --mode dev). Point the extension at the app running on this machine:
#   app:    cd app && set -a && source .env.local && set +a
#           .venv/bin/uvicorn main:app --port 8070   (+ .venv/bin/python worker.py)
#   verity: npm run build   (or npm run dev for the watcher)
# Delete this file (and rebuild) to go back to test.verisphere.co.
VITE_APP_API_BASE=http://localhost:8070/api
